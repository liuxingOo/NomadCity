# Unity 自动生成的目录，不需要进版本库
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Uu]ser[Ss]ettings/
[Mm]emoryCaptures/
[Rr]ecordings/

# Assets 下的 .meta 必须提交，不能忽略
!/[Aa]ssets/**/*.meta

# 编辑器 / IDE 缓存
.vs/
.idea/
.gradle/
ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity 崩溃时生成的信息文件
sysinfo.txt

# 打包产物
*.apk
*.aab
*.unitypackage
*.app

# Addressables 打包缓存
/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*

# 系统垃圾文件
.DS_Store
Thumbs.db
desktop.ini
